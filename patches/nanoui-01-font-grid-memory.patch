+fn string(bytes: []const u8) Error!cf.CFStringRef {
+    return cf.CFStringCreateWithBytes(null, bytes.ptr, @intCast(bytes.len), cf.utf8_encoding, false) orelse error.CoreFoundationAllocationFailed;
