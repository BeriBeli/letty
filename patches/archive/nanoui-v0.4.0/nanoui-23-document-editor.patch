+const std = @import("std");
+const ui = @import("ui.zig");
+test "external text storage rejects overflowing replacements without deleting selection" {
+    var storage: [32768]u8 = undefined;
+    var text: ui.TextBuffer = .{ .external = &storage };
+    const source = try std.testing.allocator.alloc(u8, storage.len);
+    defer std.testing.allocator.free(source);
+    @memset(source, 'x');
+    text.set(source);
+    try std.testing.expectEqual(source.len, text.len);
+    _ = text.replace(0, 1, "XX");
+    try std.testing.expect(text.overflow);
+    try std.testing.expectEqualStrings(source, text.text());
+}
+test "document editor Return inserts a newline without submitting" {
+    const Page = struct {
+        text: ui.TextBuffer = .{},
+        submitted: bool = false,
+        fn draw(self: *@This(), c: *ui.Context) void {
+            c.focus = c.peekId(null);
+            self.submitted = ui.textField(c, &self.text, .{ .multiline = true, .newline_on_enter = true, .mono = true }).submitted;
+        }
+    };
+    var page: Page = .{};
+    var tester: ui.Tester = undefined;
+    try tester.init(std.testing.allocator, .init(&page, Page.draw), .{});
+    defer tester.deinit();
+    tester.typeText("hello");
+    tester.key(.enter);
+    try std.testing.expectEqualStrings("hello\n", page.text.text());
+    try std.testing.expect(!page.submitted);
+}
