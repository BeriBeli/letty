+//! Opt-in, bounded window benchmark spans; disabled in normal application use.
+const std = @import("std");
+const clock = @import("clock.zig");
+pub const Stage = enum { geometry, frame, build, layout, paint, semaphore, drawable, encode, scheduled, vt_resize, pty_resize };
+const Sample = struct { values: [512]f64 = undefined, count: usize = 0, total: f64 = 0, maximum: f64 = 0 };
+var samples: [@typeInfo(Stage).@"enum".field_names.len]Sample = @splat(.{});
+pub var enabled = false;
+pub const Presentation = struct {
+    first_callback_ns: std.atomic.Value(u64) = .init(0),
+    callbacks: std.atomic.Value(u32) = .init(0),
+    width: std.atomic.Value(u64) = .init(0),
+    height: std.atomic.Value(u64) = .init(0),
+    first_ns: std.atomic.Value(u64) = .init(0),
+    last_ns: std.atomic.Value(u64) = .init(0),
+    count: std.atomic.Value(u32) = .init(0),
+    pub fn record(p: *Presentation, seconds: f64, width: u64, height: u64) void {
+        _ = p.callbacks.fetchAdd(1, .monotonic);
+        _ = p.first_callback_ns.cmpxchgStrong(0, @intFromFloat(clock.now() * 1e9), .monotonic, .monotonic);
+        p.width.store(width, .monotonic);
+        p.height.store(height, .monotonic);
+        // macOS can deliver a callback with presentedTime == 0. Keep that
+        // distinct from a hardware presentation timestamp, never invent one.
+        if (seconds <= 0) return;
+        const ns: u64 = @intFromFloat(seconds * 1e9);
+        _ = p.first_ns.cmpxchgStrong(0, ns, .monotonic, .monotonic);
+        p.last_ns.store(ns, .monotonic);
+        _ = p.count.fetchAdd(1, .monotonic);
+    }
+};
+// GPU callbacks may finish after a window closes. Slots live for process lifetime.
+var slots: [128]Presentation = @splat(.{});
+var next_slot: usize = 0;
+pub var presentation: ?*Presentation = null;
+pub fn begin() f64 {
+    return if (enabled) clock.now() else 0;
+}
+pub fn end(stage: Stage, start: f64) void {
+    if (enabled and start > 0) record(stage, (clock.now() - start) * 1e6);
+}
+pub fn record(stage: Stage, us: f64) void {
+    if (!enabled) return;
+    const s = &samples[@backingInt(stage)];
+    s.total += us;
+    s.maximum = @max(s.maximum, us);
+    if (s.count < s.values.len) s.values[s.count] = us;
+    s.count += 1;
+}
+pub fn reset() void {
+    samples = @splat(.{});
+    std.debug.assert(next_slot < slots.len);
+    presentation = &slots[next_slot];
+    next_slot += 1;
+    enabled = true;
+}
+pub fn dump(operation: []const u8, repeat: usize, history: usize, start: f64, call_us: f64, settle_us: f64) void {
+    enabled = false;
+    const p = presentation.?;
+    const first = p.first_ns.load(.monotonic);
+    const first_us = if (first > 0) @max(0, @as(f64, @floatFromInt(first)) / 1e3 - start * 1e6) else -1;
+    const callback_us = if (p.first_callback_ns.load(.monotonic) > 0) @as(f64, @floatFromInt(p.first_callback_ns.load(.monotonic))) / 1e3 - start * 1e6 else -1;
+    std.debug.print("WINDOW_RESULT {{\"operation\":\"{s}\",\"repeat\":{d},\"history\":{d},\"call_us\":{d:.3},\"settle_us\":{d:.3},\"first_present_us\":{d:.3},\"first_callback_us\":{d:.3},\"presentations\":{d},\"callbacks\":{d},\"presented_width\":{d},\"presented_height\":{d},\"stages\":{{", .{ operation, repeat, history, call_us, settle_us, first_us, callback_us, p.count.load(.monotonic), p.callbacks.load(.monotonic), p.width.load(.monotonic), p.height.load(.monotonic) });
+    inline for (@typeInfo(Stage).@"enum".field_names, 0..) |name, index| {
+        const s = &samples[index];
+        const n: usize = @min(s.count, s.values.len);
+        std.mem.sort(f64, s.values[0..n], {}, std.sort.asc(f64));
+        const p95 = if (n > 0) s.values[@min(n - 1, n * 95 / 100)] else 0;
+        std.debug.print("{s}\"{s}\":{{\"count\":{d},\"total_us\":{d:.3},\"max_us\":{d:.3},\"p95_us\":{d:.3}}}", .{ if (index == 0) "" else ",", name, s.count, s.total, s.maximum, p95 });
+    }
+    std.debug.print("}}}}\n", .{});
+    presentation = null;
+}
