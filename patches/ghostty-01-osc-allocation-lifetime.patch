+test "Parser allocating OOM fallback owns stable writer" {
+    const testing = std.testing;
+    for ([_]bool{ false, true }) |bulk| {
+        var failing = testing.FailingAllocator.init(testing.allocator, .{ .fail_index = 0 });
+        var p: Parser = .init(failing.allocator());
+        defer p.deinit();
+        if (bulk) p.nextSlice("52;") else for ("52;") |ch| p.next(ch);
+        try testing.expect(failing.has_induced_failure);
+        const cap = &p.capture.?;
+        try testing.expect(cap.backing == .fixed);
+        try testing.expect(cap.writer == &cap.backing.fixed);
+        const input: [Parser.MAX_BUF + 1]u8 = @splat('x');
+        if (bulk) p.nextSlice(&input) else for (input) |ch| p.next(ch);
+        try testing.expectEqual(Parser.State.invalid, p.state);
+        p.reset();
+        p.nextSlice("2;usable");
+        const command = p.end(std.ascii.control_code.bel).?.*;
+        try testing.expectEqualStrings("usable", command.change_window_title);
+    }
+}
