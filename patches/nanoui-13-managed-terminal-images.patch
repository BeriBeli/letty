+        const dv = entry.uv[3] - entry.uv[1];
+        uv = .{ entry.uv[0] + du * r.source_pixels.x / fw, entry.uv[1] + dv * r.source_pixels.y / fh, entry.uv[0] + du * (r.source_pixels.x + r.source_pixels.w) / fw, entry.uv[1] + dv * (r.source_pixels.y + r.source_pixels.h) / fh };
+    }
+    if (clipped_rect.w <= 0 or clipped_rect.h <= 0) return null;
+    if (region != null) {
+        const full_uv = uv;
+        const du = full_uv[2] - full_uv[0];
+        const dv = full_uv[3] - full_uv[1];
+        uv = .{ full_uv[0] + du * (clipped_rect.x - rect.x) / rect.w, full_uv[1] + dv * (clipped_rect.y - rect.y) / rect.h, full_uv[0] + du * (clipped_rect.x + clipped_rect.w - rect.x) / rect.w, full_uv[1] + dv * (clipped_rect.y + clipped_rect.h - rect.y) / rect.h };
+    }
+    const visible = clipped_rect.intersect(clip_in);
+    if (visible.w <= 0 or visible.h <= 0 or opacity <= 0.001) return null;
+    return .{ .rect = .{ clipped_rect.x, clipped_rect.y, clipped_rect.w, clipped_rect.h }, .clip = gpu.clip4(clip_in), .uv = uv, .color = .{ 1, 1, 1, opacity }, .radius = radius, .kind = gpu.Kind.image };
+}
