+//! Traverse exactly paint's image visibility/opacity/rectangular clip rules.
+//! Resolve every placement before emitting any image instances; overflow skips
+//! are exposed by Images.stats, not repaired by a second stale-UV paint pass.
+const types = @import("types.zig");
+const none = @import("std").math.maxInt(u32);
+pub fn prepare(c: anytype) void {
+    c.text.images.beginFrame();
+    collect(c, 0, types.Rect.infinite, 1);
+    c.text.images.prepareFrame() catch {};
+}
+fn collect(c: anytype, index: u32, clip: types.Rect, opacity_in: f32) void {
+    const n = c.node(index).*;
+    const opacity = opacity_in * n.style.opacity;
+    if (opacity <= 0.001) return;
+    const visible = n.rect.intersect(clip);
+    if (visible.w > 0 and visible.h > 0 and n.content == .image) {
+        const image = n.content.image;
+        var image_visible = true;
+        if (image.region) |r| {
+            const region_clip = types.Rect{ .x = n.rect.x + r.clip_offset.x, .y = n.rect.y + r.clip_offset.y, .w = r.clip_offset.w, .h = r.clip_offset.h };
+            const v = visible.intersect(region_clip);
+            image_visible = v.w > 0 and v.h > 0;
+        }
+        if (image_visible and image.opacity * opacity > 0.001) {
+            if (image.managed) c.text.images.requestRaw(image.key) else c.text.images.requestEncoded(image.key, image.bytes);
+        }
+    }
+    const child_clip = if (n.style.clip or n.style.scroll) visible else clip;
+    var child = n.first_child;
+    while (child != none) : (child = c.node(child).next) collect(c, child, child_clip, opacity);
+}
