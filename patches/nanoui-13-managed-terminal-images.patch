+//! Geometry shared by Context.imageRegion and its actual paint path.
+const std = @import("std");
+const types = @import("types.zig");
+const gpu = @import("gpu.zig");
+const images = @import("images.zig");
+pub const Request = struct {
+    key: u64,
+    destination: types.Rect,
+    source_pixels: types.Rect,
+    clip: types.Rect,
+    opacity: f32 = 1,
+};
+pub const Region = struct { source_pixels: types.Rect, clip_offset: types.Rect };
+fn finiteRect(r: types.Rect) bool {
+    return std.math.isFinite(r.x) and std.math.isFinite(r.y) and std.math.isFinite(r.w) and std.math.isFinite(r.h) and std.math.isFinite(r.x + r.w) and std.math.isFinite(r.y + r.h) and r.w > 0 and r.h > 0;
+}
+pub fn validate(request: Request, info: images.ManagedInfo) error{InvalidRegion}!Region {
+    const s = request.source_pixels;
+    if (!finiteRect(s) or !finiteRect(request.destination) or !finiteRect(request.clip) or !std.math.isFinite(request.opacity) or request.opacity < 0 or request.opacity > 1 or s.x < 0 or s.y < 0 or s.x + s.w > @as(f32, @floatFromInt(info.width)) or s.y + s.h > @as(f32, @floatFromInt(info.height))) return error.InvalidRegion;
+    return .{ .source_pixels = s, .clip_offset = .{ .x = request.clip.x - request.destination.x, .y = request.clip.y - request.destination.y, .w = request.clip.w, .h = request.clip.h } };
+}
