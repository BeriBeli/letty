+//! Candidate-only pure/offscreen test. Real Images and raster kernels; no mock
+//! parser, fontdb, window, clipboard or active vendor modifications.
+const std = @import("std");
+const Images = @import("images.zig").Images;
+const region = @import("image_region.zig");
+const raster = @import("raster.zig");
+const gpu = @import("gpu.zig");
+const png = @import("png.zig");
+const expect = std.testing.expect;
+const equal = std.testing.expectEqual;
+fn frame(im: *Images, keys: []const u64) !void {
+    im.beginFrame();
+    for (keys) |key| im.requestRaw(key);
+    try im.prepareFrame();
+}
+fn encode(gpa: std.mem.Allocator, color: [4]u8) ![]u8 {
+    var pixels = color;
+    return png.encode(gpa, .{ .bytes = &pixels, .width = 1, .height = 1 });
+}
+fn paint(im: *Images, key: u64, source: @import("types.zig").Rect, dest: @import("types.zig").Rect, clip: @import("types.zig").Rect, out: gpu.Pixels) !void {
+    const e = im.getRaw(key) orelse return error.MissingPreparedImage;
+    const request: region.Request = .{ .key = key, .source_pixels = source, .destination = dest, .clip = clip };
+    const geometry = try region.validate(request, im.rawInfo(key).?);
+    const instance = region.instance(e, dest, .{ .x = 0, .y = 0, .w = @floatFromInt(out.width), .h = @floatFromInt(out.height) }, geometry, 1, 0) orelse return error.MissingInstance;
+    raster.draw(out, &.{instance}, .{ .pixels = &.{}, .size = 0 }, im.pictures(), 1, .black);
+}
+
+test "managed copy replace remove ownership and full u64 key namespace" {
+    var im: Images = .{ .gpa = std.testing.allocator };
+    defer im.deinit();
+    var input = [_]u8{ 0, 0, 255, 255 };
+    const key = std.math.maxInt(u64);
+    try im.putRaw(key, 1, 1, &input);
+    @memset(&input, 0);
+    try frame(&im, &.{key});
+    var bytes: [16 * 16 * 4]u8 = undefined;
+    try paint(&im, key, .{ .w = 1, .h = 1 }, .{ .w = 16, .h = 16 }, .{ .w = 16, .h = 16 }, .{ .bytes = &bytes, .width = 16, .height = 16 });
+    for (0..256) |i| try std.testing.expectEqualSlices(u8, &.{ 0, 0, 255, 255 }, bytes[i * 4 ..][0..4]);
+    im.endFrame();
+    try im.putRaw(key, 1, 1, &.{ 255, 0, 0, 255 });
+    try equal(@as(usize, 4), im.managed_bytes);
+    try frame(&im, &.{key});
+    try paint(&im, key, .{ .w = 1, .h = 1 }, .{ .w = 16, .h = 16 }, .{ .w = 16, .h = 16 }, .{ .bytes = &bytes, .width = 16, .height = 16 });
+    try std.testing.expectEqualSlices(u8, &.{ 255, 0, 0, 255 }, bytes[0..4]);
+    im.endFrame();
+    im.remove(key);
+    im.remove(key);
+    try equal(@as(usize, 0), im.managed_bytes);
+    try expect(im.rawInfo(key) == null);
+}
+
+test "encoded LRU and identical numeric encoded key never evict managed pixels" {
+    var im: Images = .{ .gpa = std.testing.allocator, .encoded_bytes_limit = 4 };
+    defer im.deinit();
+    const bytes = try encode(std.testing.allocator, .{ 0, 255, 0, 255 });
+    defer std.testing.allocator.free(bytes);
+    try im.putRaw(7, 1, 1, &.{ 0, 0, 255, 255 });
+    try expect(im.info(7, bytes) != null);
+    try expect(im.info(8, bytes) != null);
+    try expect(!im.decoded.contains(7));
+    try expect(im.rawInfo(7) != null);
+    im.beginFrame();
+    im.requestRaw(7);
+    im.requestEncoded(7, bytes);
+    try im.prepareFrame();
+    const raw = im.getRaw(7).?;
+    const enc = im.get(7, bytes).?;
+    try expect(!std.meta.eql(raw.uv, enc.uv));
+    im.endFrame();
+    im.remove(7);
+    try expect(im.decoded.contains(7));
+}
+
+test "global managed byte cap rejects third 4MiB across simulated panes" {
+    const gpa = std.testing.allocator;
+    const input = try gpa.alloc(u8, 1024 * 1024 * 4);
+    defer gpa.free(input);
+    @memset(input, 255);
+    var im: Images = .{ .gpa = gpa };
+    defer im.deinit();
+    try im.putRaw(1, 1024, 1024, input);
+    try im.putRaw(2, 1024, 1024, input);
+    try std.testing.expectError(error.ManagedBudgetExceeded, im.putRaw(3, 1024, 1024, input));
+    try equal(@as(usize, 8 * 1024 * 1024), im.managed_bytes);
+    try expect(im.rawInfo(1) != null and im.rawInfo(2) != null and im.rawInfo(3) == null);
+    im.remove(1);
+    try im.putRaw(3, 1024, 1024, input);
+    try equal(@as(usize, 8 * 1024 * 1024), im.managed_bytes);
+}
+
+test "global managed count cap is independent of pixel byte budget" {
+    var im: Images = .{ .gpa = std.testing.allocator };
+    defer im.deinit();
+    for (1..129) |i| try im.putRaw(i, 1, 1, &.{ 0, 0, 0, 255 });
+    try std.testing.expectError(error.ManagedCountExceeded, im.putRaw(129, 1, 1, &.{ 0, 0, 0, 255 }));
+    try equal(@as(usize, 512), im.managed_bytes);
+}
+
+test "atlas overflow skips explicitly without mid-frame reset or stale UV" {
+    const gpa = std.testing.allocator;
+    const input = try gpa.alloc(u8, 1024 * 1024 * 4);
+    defer gpa.free(input);
+    @memset(input, 255);
+    var im: Images = .{ .gpa = gpa };
+    defer im.deinit();
+    try im.putRaw(1, 1024, 1024, input);
+    try im.putRaw(2, 1024, 1024, input);
+    try frame(&im, &.{ 1, 2 });
+    const first = im.getRaw(1).?;
+    const generation = im.generation;
+    try expect(im.getRaw(2) == null);
+    try expect(std.meta.eql(first, im.getRaw(1).?));
+    try equal(@as(usize, 1), im.stats.atlas_skipped);
+    try expect(!im.reset_during_frame);
+    im.endFrame();
+    try frame(&im, &.{ 1, 2 });
+    try equal(generation, im.generation); // Known rejected set does not repack.
+    try expect(std.meta.eql(first, im.getRaw(1).?));
+    try equal(@as(usize, 1), im.stats.atlas_skipped);
+    im.endFrame();
+    try frame(&im, &.{2});
+    try expect(im.getRaw(2) != null and im.getRaw(1) == null);
+    try expect(im.generation != generation);
+    im.endFrame();
+}
+
+test "visible reference limit cannot resolve an unrequested old residency" {
+    const gpa = std.testing.allocator;
+    var im: Images = .{ .gpa = gpa };
+    defer im.deinit();
+    const encoded = try encode(gpa, .{ 0, 255, 0, 255 });
+    defer gpa.free(encoded);
+    _ = im.get(1129, encoded).?; // Cached old resource must not bypass frame cap.
+    for (1..129) |i| try im.putRaw(i, 1, 1, &.{ 0, 0, 255, 255 });
+    im.beginFrame();
+    for (1..129) |i| im.requestRaw(i);
+    for (1001..1130) |i| im.requestEncoded(i, encoded);
+    try im.prepareFrame();
+    try equal(@as(usize, 1), im.stats.reference_limit);
+    try expect(im.get(1129, encoded) == null);
+    try expect(im.getRaw(1) != null);
+    im.endFrame();
+}
+
+test "paint lock prevents update and lookup cannot pack during paint" {
+    var im: Images = .{ .gpa = std.testing.allocator };
+    defer im.deinit();
+    try im.putRaw(1, 1, 1, &.{ 0, 0, 255, 255 });
+    im.beginFrame();
+    im.requestRaw(1);
+    try im.prepareFrame();
+    const generation = im.generation;
+    try std.testing.expectError(error.FrameLocked, im.putRaw(1, 1, 1, &.{ 0, 0, 0, 0 }));
+    try expect(im.get(42, "invalid bytes") == null);
+    try equal(generation, im.generation);
+    im.endFrame();
+}
+
+test "source crop translated pane clip and actual offscreen raster match" {
+    var im: Images = .{ .gpa = std.testing.allocator };
+    defer im.deinit();
+    try im.putRaw(1, 2, 1, &.{ 0, 0, 255, 255, 255, 0, 0, 255 });
+    try frame(&im, &.{1});
+    defer im.endFrame();
+    const request: region.Request = .{ .key = 1, .source_pixels = .{ .x = 1, .w = 1, .h = 1 }, .destination = .{ .x = 5, .y = 7, .w = 20, .h = 20 }, .clip = .{ .x = 9, .y = 11, .w = 12, .h = 12 } };
+    const r = try region.validate(request, im.rawInfo(1).?);
+    // Layout translated the parent by (10,20); explicit clip follows it.
+    const i = region.instance(im.getRaw(1).?, .{ .x = 15, .y = 27, .w = 20, .h = 20 }, .{ .w = 64, .h = 64 }, r, 1, 0).?;
+    try equal([4]f32{ 0, 0, 64, 64 }, i.clip);
+    try equal([4]f32{ 19, 31, 12, 12 }, i.rect);
+    var bytes: [64 * 64 * 4]u8 = undefined;
+    raster.draw(.{ .bytes = &bytes, .width = 64, .height = 64 }, &.{i}, .{ .pixels = &.{}, .size = 0 }, im.pictures(), 1, .black);
+    try std.testing.expectEqualSlices(u8, &.{ 0, 0, 0, 255 }, bytes[(30 * 64 + 20) * 4 ..][0..4]);
+    try std.testing.expectEqualSlices(u8, &.{ 255, 0, 0, 255 }, bytes[(36 * 64 + 27) * 4 ..][0..4]);
+    var invalid = request;
+    invalid.source_pixels.x = 2;
+    try std.testing.expectError(error.InvalidRegion, region.validate(invalid, im.rawInfo(1).?));
+}
+
+test "failed raw copy and failed atlas prepare do not leak or expose stale entries" {
+    for (0..2) |offset| {
+        var failure = std.testing.FailingAllocator.init(std.testing.allocator, .{});
+        var im: Images = .{ .gpa = failure.allocator() };
+        var live = true;
+        defer if (live) im.deinit();
+        try im.putRaw(1, 1, 1, &.{ 0, 0, 255, 255 });
+        failure.fail_index = failure.alloc_index + offset;
+        im.beginFrame();
+        im.requestRaw(1);
+        try std.testing.expectError(error.OutOfMemory, im.prepareFrame());
+        try expect(im.stats.prepare_failed and im.getRaw(1) == null);
+        im.endFrame();
+        failure.fail_index = std.math.maxInt(usize);
+        try frame(&im, &.{1});
+        try expect(im.getRaw(1) != null);
+        im.endFrame();
+        im.deinit();
+        live = false;
+        try equal(failure.allocated_bytes, failure.freed_bytes);
+    }
+    for (0..2) |fail_index| {
+        var failure = std.testing.FailingAllocator.init(std.testing.allocator, .{ .fail_index = fail_index });
+        var im: Images = .{ .gpa = failure.allocator() };
+        var live = true;
+        defer if (live) im.deinit();
+        try std.testing.expectError(error.OutOfMemory, im.putRaw(1, 1, 1, &.{ 0, 0, 255, 255 }));
+        try equal(@as(usize, 0), im.managed_bytes);
+        try expect(im.rawInfo(1) == null);
+        im.deinit();
+        live = false;
+        try equal(failure.allocated_bytes, failure.freed_bytes);
+    }
+}
