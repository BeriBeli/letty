+            const scaled: f64 = point * scale;
+            const rounded = if (up) @ceil(scaled) else @floor(scaled);
+            return @intFromFloat(std.math.clamp(rounded, 0, @as(f64, @floatFromInt(limit))));
+        }
+    };
+}
+pub fn GpuTracker(comptime Instance: type) type {
