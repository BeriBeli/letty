+fn onPreedit(_: *anyopaque, data: ?*anyopaque) callconv(.c) void {
+    const s = of(data);
+    var str: ?[*:0]u8 = null;
+    var cursor: c_int = 0;
+    gtk.api.gtk_im_context_get_preedit_string(s.im, &str, null, &cursor);
+    const p = str orelse return;
+    defer gtk.api.g_free(p);
+    var ops = [_]ctx_mod.TextOp{.{ .set_marked = .{ .text = std.mem.span(p), .sel_start = @intCast(@max(0, cursor)), .sel_len = 0 } }};
+    s.ctx.input.ops = &ops;
+    s.frame();
+    s.ctx.input.ops = &.{};
+}
+
+fn filterKey(s: *Surface, e: *gtk.Event) c_int {
+    s.filtering = true;
+    defer s.filtering = false;
+    return gtk.api.gtk_im_context_filter_keypress(s.im, e);
+}
+fn onKeyRelease(_: *gtk.Widget, e: *gtk.Event, data: ?*anyopaque) callconv(.c) c_int {
+    const s = of(data);
+    const result = filterKey(s, e);
+    if (s.committed.items.len > 0) { s.ctx.input.chars = s.committed.items; s.frame(); s.committed.clearRetainingCapacity(); }
+    return result;
+}
