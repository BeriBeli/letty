# ~/.config/letty/config (or $XDG_CONFIG_HOME/letty/config)
# Current runtime: key=value, whole-line comments, no JSON or legacy keys.
# Validate with: LETTY_CONFIG=/absolute/path/to/config letty --check-config

theme = letty
font-size = 13
# Empty font-family selects the bundled JetBrainsMono Nerd Font.
font-family = ""
font-ligatures = true
line-height = 1.22
cursor-style = block
cursor-style-blink = true
scrollback-limit = 4
language = system
window-theme = system
background = rex
confirm-close = true
git-status = true
diff-layout = auto
clipboard-read = ask
right-click-action = context-menu

# Set a shell executable for newly created terminals.
# command = /bin/zsh
# Repeated values are supported for environment and bindings.
# env = EDITOR=vi
# keybind = Ctrl+F5=session.new
# keybind = none=session.newHome
# Use a catalog theme, an absolute custom-theme path, or separate light/dark names.
# theme = light:letty,dark:Gruvbox Dark
