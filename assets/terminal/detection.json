          {
            "line_regex": [
              "^\\s*[\\x{002A}\\x{00B7}\\x{2722}\\x{2733}\\x{2736}\\x{273B}\\x{273D}]\\s+\\S.*…(?:\\s+\\(\\d+[smh](?:\\s|·)|\\s*$)"
            ]
          }
        ]
      },
      {
        "id": "background_agents_working",
        "state": "working",
        "priority": 965,
