        "region": "osc_title",
        "visible_working": true,
        "regex": [
          "^[\\x{2800}-\\x{28FF}\\x{25D0}-\\x{25D3}] "
        ]
      },
      {
        "id": "live_turn_working",
        "state": "working",
        "priority": 970,
        "region": "bottom_non_empty_lines(12)",
        "visible_working": true,
        "any": [
          {
            "line_regex": [
              "^\\s*[⏸⏵].*esc to interrupt(?:\\s|·|$)"
            ]
